        @media(min-width:1024px){ .masonry{ column-count:3; } }
        .masonry-item { break-inside: avoid; margin-bottom:16px; }
        ::-webkit-scrollbar { width:6px; }
        ::-webkit-scrollbar-thumb { background:#c9a86a; }
        @keyframes logoFadeIn {
