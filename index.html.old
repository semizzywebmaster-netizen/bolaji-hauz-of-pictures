        @keyframes logoPulse {
          0%,100% { transform: scale(1); opacity:0.6; }
          50% { transform: scale(1.12); opacity:0.15; }
        }
        @keyframes logoShimmer {
          0% { transform: translateX(-100%) rotate(15deg); }
          100% { transform: translateX(200%) rotate(15deg); }
        }
